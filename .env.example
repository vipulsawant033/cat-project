FIGMA_PAT=your_figma_personal_access_token
ANGULAR_SOURCE_PATH=../path/to/angular/project/src
LIT_SOURCE_PATH=../path/to/lit/components/src
SCSS_TOKENS_PATH=../path/to/tokens/_variables.scss
DB_PATH=./data/component-map.db
LOG_LEVEL=info
CACHE_TTL_SECONDS=300
# Optional: name of the Figma Variable mode to resolve against (e.g. Light, Dark, Compact).
# Defaults to each variable collection's default mode. Only relevant if your Figma file
# uses Variables (requires a Figma Enterprise plan) rather than plain Styles.
FIGMA_VARIABLE_MODE=
# Optional: max recursion depth for a single codegen_from_node call (default: 16).
# Subtrees deeper than this are reported via `truncated`/`truncatedNodes` in the result.
CODEGEN_MAX_DEPTH=
