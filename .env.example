# Figma personal access token (Figma → Settings → Security → Generate new token).
# Required only when reading Figma via REST (figma_import_node, figma_extract_tokens)
# instead of the official Dev Mode MCP / plugin paths.
FIGMA_TOKEN=figd_your_token_here

# LLM provider fallback — only needed if your MCP host lacks sampling support.
# Leave blank to rely on the host's own model (no keys required).
LLM_PROVIDER=

# Anthropic provider (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI provider (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1
