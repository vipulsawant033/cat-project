# Figma Personal Access Token (Figma > Settings > Personal access tokens)
# Required by src/figma/client.ts to call the Figma REST API.
FIGMA_TOKEN=

# Port for the REST bridge server (src/bridge/rest-server.ts)
BRIDGE_PORT=4000

# Optional: directory where generated Angular component files are written to disk
# in addition to being returned in the tool response. Leave blank to skip writing to disk.
OUTPUT_DIR=./output

# Optional: directory where exported icon .svg files are written when writeToDisk is
# true. Generated templates reference icons as "/icons/<file>", matching Angular's
# default public/ asset convention — point this at the target workspace's public/icons
# folder (e.g. <consuming-app>/public/icons), not this server's own. Defaults to
# ./public/icons if unset.
ICONS_DIR=

# Optional: default Angular workspace/library directory for lib_index_components
# to scan (e.g. your CAT Blocks Angular-wrapper repo checkout). Can also be passed
# per-call as the tool's libraryDir input instead.
COMPONENT_LIBRARY_DIR=

# Optional: where lib_index_components persists its scan results (read by
# lib_search_component/lib_get_component). Defaults to ./component-library-index.json.
LIBRARY_INDEX_FILE=

# Optional: where lib_map_figma_to_component persists Figma-to-Angular mappings.
# Defaults to ./figma-library-mappings.json — commit this file, it's the mapping table.
MAPPING_FILE=

# Optional: where generate_angular_component/generate_angular_page record generation
# history, and codegen_diff attaches its results (read by codegen_detect_drift and
# manifest_list). Defaults to ./figma-generation-manifest.json — commit this file,
# it's the round-trip manifest.
MANIFEST_FILE=
