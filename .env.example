# Figma Personal Access Token (Figma > Settings > Personal access tokens)
# Required by src/figma/client.ts to call the Figma REST API.
FIGMA_TOKEN=

# Port for the REST bridge server (src/bridge/rest-server.ts)
BRIDGE_PORT=4000

# Optional: directory where generated Angular component files are written to disk
# in addition to being returned in the tool response. Leave blank to skip writing to disk.
OUTPUT_DIR=./output
